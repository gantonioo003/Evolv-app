  "description": "Hierarquia multidimensional das intencoes do Coach Evolv.",
  "domains": [
    { "id": "training", "description": "Treino, exercicios, modalidades e organizacao de sessoes." },
    { "id": "nutrition", "description": "Alimentacao, preparo, refeicoes e estrategias alimentares." },
    { "id": "recovery", "description": "Sono, fadiga, estresse, descanso e recuperacao." },
